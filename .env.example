# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# AI provider switch: gemini | anthropic | gateway (unset = first one configured)
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...       # for AI_PROVIDER=anthropic
# AI_GATEWAY_API_KEY=...             # gateway outside Vercel (on Vercel, OIDC needs no key)
# AI_MODEL=                          # optional model override

# Public site URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
