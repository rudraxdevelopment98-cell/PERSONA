# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# AI: no key is needed when deployed on Vercel - the app uses Vercel AI Gateway
# with the deployment's automatic OIDC token. Optional alternatives:
# ANTHROPIC_API_KEY=sk-ant-...        # call the Claude API directly
# AI_GATEWAY_API_KEY=...              # use AI Gateway from outside Vercel
# AI_MODEL=anthropic/claude-opus-5.5  # override the model

# Public site URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
