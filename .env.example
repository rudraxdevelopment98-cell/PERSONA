# Database (Neon / any PostgreSQL). On Vercel these are added automatically
# when you connect a Neon database to the project.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=...   # optional direct connection used for migrations

# Login sessions - a long random string (e.g. `openssl rand -hex 32`).
# Optional: if unset, a secret is derived from DATABASE_URL.
BETTER_AUTH_SECRET=
# Public URL of the app (optional on Vercel)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider switch: gemini | anthropic | gateway (unset = first one configured)
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...       # for AI_PROVIDER=anthropic
# AI_GATEWAY_API_KEY=...             # gateway outside Vercel (on Vercel, OIDC needs no key)
# AI_MODEL=                          # optional model override
